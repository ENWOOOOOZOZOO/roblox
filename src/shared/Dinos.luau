function Dinos.Trouver(nom)
	for _, dino in ipairs(Dinos.Liste) do
		if dino.Nom == nom then
			return dino
		end
	end
	return nil
end

function Dinos.ParRarete(rarete)
	local res = {}
	for _, dino in ipairs(Dinos.Liste) do
		if dino.Rarete == rarete then
			table.insert(res, dino)
		end
	end
	return res
end

return Dinos
